@model CapProject.ViewModels.LightSaberVM
@{
    ViewData["Title"] = "Choice a Switch";
}

<!DOCTYPE html>
<html>

<head>
    <title>Switch</title>
</head>

<body>
    <h1>Choose Your Switch</h1>

    <form asp-action="EditSwitch" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <input type="hidden" asp-for="idGiven" />

        <div>
            <label asp-for="switchSelected" class="form-label">Switch</label>
            @*   <input asp-for="switchSelected" class="form-control" /> *@ <!--This line caused a "0" in the dropdown-->
            <select asp-for="switchSelected" asp-items="Model.switchOptions" class="form-control">
                <option value="">-- Select a Switch --</option>

            </select>

            <span asp-validation-for="switchSelected" class="text-danger"></span>

        </div>
        <button type="submit" class="btn btn-primary">Next</button>

    </form>

</body>
</html>