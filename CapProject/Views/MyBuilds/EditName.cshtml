@using CapProject.ViewModels
@model LightSaberVM
@{
    ViewData["Title"] = "New Builds";
}

<!DOCTYPE html>
<html>

<head>
    <title>Editing Build</title>

    <!--Page-specific styles-->
    <style>

        #info {
            border-bottom: 1px solid;
            border-bottom-color: #2E557C;
        }

    </style>
</head>


    <body>
    <h2>Creating a New Lightsaber</h2>
        <br />
        <br />
        <form asp-action="EditName" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="idGiven" />

            <div class="mb-3">
                <label asp-for="nameSelected" class="form-label">Name:</label>
                <input asp-for="nameSelected" class="form-control" />
                <span asp-validation-for="nameSelected" class="text-danger"></span>
            </div>
 
             <button type="submit" class="btn btn-primary">Next</button>
    
        </form>

    </body>

</html>

