@model List<Lightsaber>
@{
    ViewData["Title"] = "My Builds";
}


<!--Styles for MyBuilds page-->
<style>

    table > * {
        color: white;
        border: 1px solid;
    }

    tr > td {
        color:white;
    }

</style>


<br /> 




<body>

    <h2>My Builds</h2>
    <div id="subtext">
        <i>
            Manage your previous builds, or remove them.
        </i>
    </div>
    <br />
    <br />

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var lightsaber in Model) {
            <tr>
                <td>@lightsaber.name</td>
                <td>
                    <a asp-controller="MyBuilds" asp-action="Edit"
                        asp-route-lsID="@lightsaber.lightsaber_id">
                        Edit</a>

                    <a asp-controller="MyBuilds" asp-action="Delete"
                        asp-route-lsID="@lightsaber.lightsaber_id">
                        Delete
                    </a>
                </td>
            </tr>
        } @*End foreach*@
    </tbody>
</table>


</body>