<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CapProject</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CapProject.styles.css" asp-append-version="true" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>

    <!--
        Old Republic colors

        #7E7863 - Brown ish
        #AD7D37 - Tan ish
        #2E557C - Gray-blue (good one)
        #381010 - Maroon?
        #334E30 - Green ish

        Jedi Order
        #1B4F72 (Primary - Deep Blue)
        #FFFFFF (Secondary - White)
        #FFD700 (Accent - Gold)
        #D3D3D3 (Complementary - Light Grey) - Replacing with #9CAF88
        #C0C0C0 (Complementary - Silver)

        Rich Black - 000011

        Temple Jedi
        #708090 (Primary - Stone Grey)
        #FFFFFF (Secondary - White)
        #E6BE8A (Accent - Pale Gold)
        #D3D3D3 (Complementary - Light Grey)
        #1E90FF (Complementary - Deep Blue AKA Dodger Blue)

    -->

    <style>

       .nav-container {
            border-bottom: 1px solid #FFE81F;
          padding: 8px;
        }
        .nav-item {
          color: white;
          size: 14pt;
          padding: 10px 30px;
            border-right: 1px solid #FFE81F;
        }

    </style>


</head>
<body class="bg-dark text-white">
    <header>
        <nav class="navbar navbar-expand-md navbar-dark fixed-top margin-bottom: 20px ">
            <div class="container-fluid justify-content-start">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">CapProject</a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/">Home</a>
                        </li>                     
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="ThreeJS">Three.js Example</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="NewBuild" asp-action="Index">New Build</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="MyBuilds" asp-action="Index">My Builds</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Help">Help</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="About">About</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container mt-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - CapProject - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
