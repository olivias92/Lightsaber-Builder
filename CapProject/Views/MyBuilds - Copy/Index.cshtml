@model List<Lightsaber>
@{
    ViewData["Title"] = "My Builds";
}

<style>

    table > * {
        color: white;
    }

    tr > td {
        color:white;
    }

</style>

<br />
<br /> 
<h2>My Builds</h2>


<body>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var lightsaber in Model) {
            <tr>
                <td>@lightsaber.name</td>
                <td>
                    <a asp-controller="MyBuilds" asp-action="Edit"
                        asp-route-id="@lightsaber.lightsaber_id">
                        Edit</a>

                    <a asp-controller="MyBuilds" asp-action="Delete"
                        asp-route-id="@lightsaber.lightsaber_id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>


</body>