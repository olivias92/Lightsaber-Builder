@model CapProject.ViewModels.LightSaberVM

@{
    ViewData["Title"] = "Choose an Emitter";
}

<!DOCTYPE html>
<html>

<head>
    <title>Emitter</title>

    <!--Page-specific styles-->
    <style>

        h1 {
            border-bottom: 1px solid #FFE81F;
        }

        #threejs-container {
            width: 500px;
            height: 400px;
            border: 2px solid #ccc;
            margin-right: 50px;
            position: initial;
            overflow: hidden;
        }

        section {
            
        }

        #form {
            margin-top: 85px;
            margin-left: 100px;
        }

        h1 {
            margin-bottom: 50px;
            border-bottom: 1px solid;
            border-bottom-color: #2E67F8;
        }
        
        button {
            margin-top: 10px;
        }

        .btn-primary:hover {
            background-color: #0056b3;
            box-shadow: 0px 0px 8px rgba(0, 86, 179, 0.5);
        }

        #info {
            border-bottom: 1px solid;
            border-bottom-color: #2E557C;
        }

    </style>

</head>

    <body>
        <h1>Choose Your Emitter</h1>

        <main>
        <!--Scripts for stlLoad.js-->

        <script type="importmap">
            {
              "imports": {
                "three": "/js/three/build/three.module.min.js",
                "three/examples/jsm/loaders/STLLoader.js": "/js/three/examples/jsm/loaders/STLLoader.js"
              }
            }
        </script>

        <script type="module" src="~/js/stlLoad.js"></script>
        <script>
            console.log("Inline script is running for Emitter!");
        </script>

        <!--Div for the .STL files to display-->
       
        <div class="container">
            <div class="row">
                <div class="col-md-8">
                    <div id="threejs-container"></div>
                </div>


                
                <div class="col-md-4">

                    <!--Div for info-->
                    <div id="info">                       
                        <p><i>The gateway for the blade to emit from the Kyber crystal.</i></p>
                    </div>
                    <br />
                    <br />
                    <br />

                    <form asp-action="Emitter" method="post">
                        
                        <div asp-validation-summary="All" class="text-danger"></div>

                            <label asp-for="emitterOptions" class="form-label">Emitter</label>
                
                            <select asp-for="emitterSelected" asp-items="Model.emitterOptions" id="componentSelect" class="form-control">
                                <option value="">-- Select an Emitter --</option>
                            </select>

                            <script>
                                const stlFiles = @Html.Raw(Json.Serialize(Model.emitterPath));

                                document.getElementById("componentSelect").addEventListener("change", function() {
                                    const selectedComponent = this.value;
                                    if (stlFiles[selectedComponent]) {
                                        loadModel(stlFiles[selectedComponent]);
                                    }
                                });

                                   
                            </script>

                            <span asp-validation-for="emitterSelected" class="text-danger"></span>
                            
                             <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">Next</button>


                            
                    </form>
                </div>
            </div>
        </div>
    </main>
    </body>

</html>
