@using CapProject.ViewModels
@model LightSaberVM
@{
    ViewData["Title"] = "New Builds";
}

<!DOCTYPE html>
<html>

<head>
    <title>New Build</title>

    <!--Page-specific styles-->
    <style>

        title {
            border-bottom: 1px solid #FFE81F;
        }

        #info {
            border-bottom: 1px solid;
            border-bottom-color: #2E557C;
        }

    </style>


</head>


    <body>
        <br />
     
    <h2>Creating a New Lightsaber</h2>

        <br />
        <br />


        <!--Div for info-->
        <div id="info">
            <p>
                <i>
                    Who will wield this Lightsaber?
                </i>
            </p>
        </div>

        <form asp-action="Index" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="nameSelected" class="form-label">Name:</label>
                <input asp-for="nameSelected" class="form-control" />
                <span asp-validation-for="nameSelected" class="text-danger"></span>
            </div>
 
             <button type="submit" class="btn btn-primary">Next</button>
    
        </form>

    </body>

</html>

